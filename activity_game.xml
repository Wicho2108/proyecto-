<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A237E">

    <LinearLayout
        android:id="@+id/panelSuperior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:background="#303F9F"
        android:padding="15dp">

        <TextView
            android:id="@+id/txtTiempo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tiempo: 60s"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPuntos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pares: 0"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/tableroCartas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/panelSuperior"
        android:layout_above="@+id/panelInferior"
        android:columnCount="4"
        android:rowCount="4"
        android:padding="10dp"
        android:background="#1A237E" />

    <LinearLayout
        android:id="@+id/panelInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:padding="10dp"
        android:background="#303F9F">

        <Button
            android:id="@+id/btnSalirJuego"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:text="Salir"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtMensaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Memorama\n¡Encuentra los pares!"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="20dp"
        android:background="#00000080"
        android:visibility="visible" />
</RelativeLayout>